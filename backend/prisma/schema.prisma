generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum ReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMoveType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum AdjustmentStatus {
  COMPLETED
}

enum DeliveryStatus {
  READY
  PICKED
  PACKED
  DELIVERED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  loginId      String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetOtps PasswordResetOtp[]

  createdTransfers   Transfer[]
  receiptsCreated    Receipt[]
  deliveriesCreated  Delivery[]
  createdAdjustments StockAdjustment[]
}

model PasswordResetOtp {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash String

  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  category      String
  unitOfMeasure String
  initialStock  Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receiptItems  ReceiptItem[]
  deliveryItems DeliveryItem[]
  transferItems TransferItem[]
  stocks        Stock[]
  stockLedger   StockLedger[]
  adjustments   StockAdjustment[]
}

model Supplier {
  id       String  @id @default(uuid())
  name     String
  email    String?
  phone    String?
  address  String?
  isActive Boolean @default(true)

  receipts Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  address  String?
  isActive Boolean @default(true)

  locations Location[]

  stocks Stock[]

  stockLedger StockLedger[]

  sourceTransfers Transfer[] @relation("TransferSourceWarehouse")

  destinationTransfers Transfer[]        @relation("TransferDestinationWarehouse")
  adjustments          StockAdjustment[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  receipts             Receipt[]
  deliveries           Delivery[]
}

model Location {
  id          String @id @default(uuid())
  name        String
  code        String
  warehouseId String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  receipts        Receipt[]
  deliveries      Delivery[]
  stocks          Stock[]
  stockLedger     StockLedger[]
  sourceTransfers Transfer[]    @relation("TransferSourceLocation")

  destinationTransfers Transfer[]        @relation("TransferDestinationLocation")
  adjustments          StockAdjustment[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([warehouseId, code])
}

model Receipt {
  id String @id @default(uuid())

  sequence  Int    @default(autoincrement())
  reference String @unique

  supplierId  String
  warehouseId String
  locationId  String

  scheduleDate DateTime?
  status       ReceiptStatus @default(DRAFT)

  createdById String

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  items       ReceiptItem[]
  stockLedger StockLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([status])
}

model ReceiptItem {
  id String @id @default(uuid())

  receiptId String
  productId String
  quantity  Float

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([receiptId, productId])
}

model Stock {
  id String @id @default(uuid())

  productId   String
  warehouseId String
  locationId  String

  quantity Float @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([warehouseId])
}

model StockLedger {
  id String @id @default(uuid())

  productId   String
  warehouseId String
  locationId  String

  moveType      StockMoveType
  quantityDelta Float
  stockAfter    Float

  referenceType String
  referenceId   String

  receiptId    String?
  deliveryId   String?
  transferId   String?
  adjustmentId String?

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])

  receipt    Receipt?         @relation(fields: [receiptId], references: [id])
  delivery   Delivery?        @relation(fields: [deliveryId], references: [id])
  transfer   Transfer?        @relation(fields: [transferId], references: [id])
  adjustment StockAdjustment? @relation(fields: [adjustmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([locationId])
  @@index([referenceId])
  @@index([moveType])
}

model Customer {
  id       String  @id @default(uuid())
  name     String
  email    String?
  phone    String?
  address  String?
  isActive Boolean @default(true)

  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Delivery {
  id String @id @default(uuid())

  sequence  Int    @default(autoincrement())
  reference String @unique

  customerId  String
  warehouseId String
  locationId  String

  scheduleDate DateTime?
  status       DeliveryStatus @default(READY)

  createdById String

  customer  Customer  @relation(fields: [customerId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  items       DeliveryItem[]
  stockLedger StockLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([status])
}

model DeliveryItem {
  id String @id @default(uuid())

  deliveryId String
  productId  String
  quantity   Float

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([deliveryId, productId])
}

model Transfer {
  id        String @id @default(uuid())
  sequence  Int    @default(autoincrement())
  reference String @unique

  sourceWarehouseId String
  sourceLocationId  String

  destinationWarehouseId String
  destinationLocationId  String

  status TransferStatus @default(DRAFT)

  createdById String

  sourceWarehouse Warehouse @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])

  sourceLocation Location @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id])

  destinationWarehouse Warehouse @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  destinationLocation Location @relation("TransferDestinationLocation", fields: [destinationLocationId], references: [id])

  createdBy User @relation(fields: [createdById], references: [id])

  items TransferItem[]

  stockLedger StockLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceWarehouseId])
  @@index([sourceLocationId])
  @@index([destinationWarehouseId])
  @@index([destinationLocationId])
  @@index([status])
}

model TransferItem {
  id String @id @default(uuid())

  transferId String
  productId  String
  quantity   Float

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([transferId, productId])
}

model StockAdjustment {
  id String @id @default(uuid())

  sequence  Int    @default(autoincrement())
  reference String @unique

  productId   String
  warehouseId String
  locationId  String

  systemQuantity  Float
  countedQuantity Float
  quantityDelta   Float

  reason String?

  status AdjustmentStatus @default(COMPLETED)

  createdById String

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  stockLedger StockLedger[]

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([createdAt])
}
